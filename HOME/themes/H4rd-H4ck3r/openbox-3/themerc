# Menu
menu.border.color: #eee9fc

menu.title.bg: Solid Flat
menu.title.bg.color: #453951
menu.title.bg.shadow: 0
menu.title.text.color: #ebde76
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #453951
menu.items.text.color: #ebde76
menu.items.disabled.text.color: #c1b46c

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #b1baf4
menu.items.active.text.color: #ebde76

menu.separator.color: #c1b46c
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #453951

# Active window
window.active.border.color: #e965a5


window.active.title.bg: flat solid
window.active.title.bg.color: #453951
window.active.title.separator.color: #453951
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #ebde76

window.active.handle.bg: flat solid
window.active.handle.bg.color: #453951

window.active.grip.bg: flat solid
window.active.grip.bg.color: #453951

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #453951
window.active.button.unpressed.image.color: #ebde76

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #b1baf4
window.active.button.pressed.image.color: #2c2433

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #453951
window.active.button.disabled.image.color: #c1b46c

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #453951
window.active.button.hover.image.color: #b1baf4

#window.active.button.toggled.bg: #b1baf4
#window.active.button.toggled.image.color: #2c2433

# Inactive window
window.inactive.border.color: #b1baf4

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #453951
window.inactive.title.separator.color: #453951
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #c1b46c

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #453951

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #453951

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #453951
window.inactive.button.unpressed.image.color: #c1b46c

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #b1baf4
window.inactive.button.pressed.image.color: #2c2433

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #c1b46c
window.inactive.button.disabled.image.color: #453951

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #453951
window.inactive.button.hover.image.color: #b1baf4


# OSD
osd.border.width: 1
osd.border.color: #b1baf4

osd.bg: flat solid
osd.bg.color: #453951
osd.label.bg: flat solid
osd.label.bg.color: #453951
osd.label.text.color: #ebde76

# OSD
osd.bg: Solid Flat
osd.bg.color: #453951
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #b1baf4
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2c2433

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #b3f4f3
#osd.button.unpressed.*.border.color: #3f3951

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #b1baf4
#osd.button.pressed.*.border.color: #2c2433

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #eee9fc
#osd.button.focused.*.border.color: #2c2433

osd.button.focused.box.color: #b1baf4


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 4
padding.width: 8
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
